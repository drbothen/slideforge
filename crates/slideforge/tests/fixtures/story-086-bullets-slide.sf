# STORY-086 fixture: content slide with a variable-bound bullet list.
#
# FORWARD-LOOKING FIXTURE — pending STORY-088 (DSL list-literal parser).
#
# This fixture uses the INTENDED canonical bullets DSL form:
#
#   @var items = ["Item A", "Item B", "Item C"]
#
#   slide content:
#     title "Agenda"
#     bullets: items
#
# The `@var` block with list-literal syntax (`[...]`) and the `bullets: items`
# binding (where `items` resolves to `Value::List`) represent the fully correct
# DSL path for bullet slides.
#
# This fixture will NOT parse with the current parser — the vars: block
# value_parser() does not yet support list literals. Parsing support is
# delivered in STORY-088 (DSL list-literal parser).
#
# The e2e AC-007 test that loads this fixture is therefore `#[ignore]`'d:
#   test_bc_1_16_001_ac007_bullets_slide_produces_ge3_text_runs_in_pptx
#   (crates/slideforge/tests/e2e/story_086_content_threading.rs)
#
# The load-bearing AC-007 coverage is the Stage-2b unit test:
#   test_bc_1_16_001_ac007_value_list_produces_content_block_bullets
#   (crates/slideforge-eval/tests/field_to_block_unit.rs)
# which exercises the Value::List → ContentBlock::Bullets path directly
# without DSL parsing.
#
# When STORY-088 ships list-literal support, un-ignore the e2e test and
# verify it passes with this fixture as-is.

slideforge_version "1"
lang "en-US"

@var items = ["Item A", "Item B", "Item C"]

slide content:
  title "Agenda"
  bullets: items
