# STORY-086 fixture: chart slide WITHOUT alt text (no alt field, no decorative).
#
# Used by: AC-005 (strict + chart WITHOUT alt → Err(ValidationFailed) + E-A11-001).
# In strict mode, this must return exactly one E-A11-001 diagnostic.
#
# STORY-098 (F-098-P1-005): added data: field — ChartEmptyDataValidator now
# requires non-empty data; without it E-LAY-003 is emitted in addition to
# E-A11-001, breaking the "exactly 1 E-A11-001" assertion.

slideforge_version "1"
lang "en-US"

slide chart:
  title "Revenue"
  chart_type "bar"
  data ["Q1: 80", "Q2: 90"]
