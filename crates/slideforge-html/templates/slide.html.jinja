<article id="slide-{{ slide_index }}" aria-label="Slide {{ slide_index }}">
  {# SVG canvas for slide content — no <canvas> elements (BC-4.03.003 invariant 2) #}
  <svg xmlns="http://www.w3.org/2000/svg"
       width="{{ page_width }}"
       height="{{ page_height }}"
       role="img"
       aria-label="{{ slide_title }}">
    <title>{{ slide_title }}</title>
    {# Per-frame elements are injected here by the Rust render layer #}
    {{ slide_content }}
  </svg>
</article>
