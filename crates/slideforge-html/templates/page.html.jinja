<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <style>
    /* sf-visually-hidden: hides element visually while keeping it accessible to AT.
       Used for synthesized <h1> on chart-only / image-only decks (HIGH-1 / BC-4.03.003). */
    .sf-visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  </style>
</head>
<body>
  <main>
    {% if synthetic_h1 %}<h1 class="sf-visually-hidden">{{ synthetic_h1 | safe }}</h1>
    {% endif %}
    {% for slide_html in slides %}
    {{ slide_html | safe }}
    {% endfor %}
  </main>
</body>
</html>
