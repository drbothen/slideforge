# EditorConfig: https://editorconfig.org
# Applied to all files in the slideforge workspace.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown sometimes needs trailing spaces for soft line breaks.
[*.md]
trim_trailing_whitespace = false

# TOML / YAML / JSON conventionally use 2-space indents.
[*.{toml,yml,yaml,json}]
indent_size = 2

# Slideforge DSL files use 2-space indents (matches YAML conventions).
[*.sf]
indent_size = 2

# Makefile syntax requires tabs.
[Makefile]
indent_style = tab
