# Rust build artifacts
/target/
**/*.rs.bk
**/*.rs.bak
**/*.rs.bak[0-9]*
**/target/

# Cargo.lock policy: COMMIT it (slideforge produces binaries via slideforge-cli).
# Library-only crates would not commit this; we do.
# !Cargo.lock

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*.iml

# OS
.DS_Store
Thumbs.db

# insta snapshot test pending files (the .snap files ARE committed; .snap.new
# are pending review and should be reviewed and committed/rejected, not gitignored).
# *.snap.new

# Misc
*.pdb
*.log

# Distribution outputs (these are created by release scripts, not committed).
/dist/
/releases/

# Coverage artifacts
/coverage/
*.profraw
*.profdata

.mcp.json

# Factory artifacts belong on the factory-artifacts orphan branch, not on
# feature/develop branches. Gitignore here prevents accidental leaks from
# per-story worktrees (seen in STORY-027, STORY-029, STORY-034, STORY-036).
/.factory/
