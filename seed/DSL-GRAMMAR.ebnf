(* ======================================================================== *)
(* Slideforge DSL Grammar v0.1                                              *)
(* ======================================================================== *)
(*                                                                          *)
(*   Notation: Extended Backus-Naur Form (EBNF) with the following          *)
(*   conventions:                                                           *)
(*                                                                          *)
(*     A ::= B            A is defined as B                                 *)
(*     A | B              A or B (alternation)                              *)
(*     A B                A followed by B (concatenation)                   *)
(*     A?                 A is optional (zero or one)                       *)
(*     A*                 A repeated zero or more times                     *)
(*     A+                 A repeated one or more times                      *)
(*     ( A )              grouping                                          *)
(*     "literal"          literal text token                                *)
(*     'c'                single literal character                          *)
(*     /regex/            regular-expression pattern                        *)
(*     (* comment *)      grammar comment                                   *)
(*                                                                          *)
(*   Layout-sensitivity:                                                    *)
(*                                                                          *)
(*   The grammar uses INDENT/DEDENT/NEWLINE tokens produced by the lexer    *)
(*   based on leading whitespace, following the Python tokenizer pattern.   *)
(*   Tabs and spaces are not mixed; the lexer normalizes a tab to four      *)
(*   spaces before indentation tracking. An INDENT token is emitted when    *)
(*   indentation increases; one or more DEDENT tokens are emitted when      *)
(*   indentation decreases.                                                 *)
(*                                                                          *)
(*   chumsky 0.10+ supports context-sensitive grammars natively, including  *)
(*   the kind of semantic indentation this grammar requires. The parser     *)
(*   implementation should integrate the indentation lexer with chumsky's   *)
(*   token stream.                                                          *)
(*                                                                          *)
(* ======================================================================== *)

(* -- Top-level program ------------------------------------------------- *)

program          ::= ( metadata_section | slide )+

(* -- Metadata block ---------------------------------------------------- *)

metadata_section ::= "metadata" ":" NEWLINE INDENT metadata_field+ DEDENT

metadata_field   ::= identifier value NEWLINE

(* -- Slide blocks ------------------------------------------------------ *)

slide            ::= "slide" slide_type ":" NEWLINE INDENT field+ DEDENT

slide_type       ::= "title"              | "content"            | "two_column"
                   | "content_stat"       | "stat_callout"       | "stats_summary"
                   | "highlight"          | "highlight_boxes"    | "split_contrast"
                   | "card_rows"          | "severity_cards"     | "numbered_actions"
                   | "vertical_timeline"  | "horizontal_timeline" | "enhanced_table"
                   | "table"              | "status"             | "progress_bar"
                   | "metric_tree"        | "formula"            | "weighted_composite"
                   | "key_metrics"        | "divider"            | "end"

(* -- Slide fields ------------------------------------------------------ *)

field            ::= key_value
                   | key_block
                   | key_list

key_value        ::= identifier value NEWLINE

key_block        ::= identifier ":" NEWLINE INDENT field+ DEDENT

key_list         ::= identifier ":" NEWLINE INDENT list_item+ DEDENT

(* Note on repetition: Some identifiers (e.g. `category`, `term`,           *)
(* `box`, `stat`) appear multiple times under the same parent.             *)
(* The grammar does not distinguish these from `key_block` -- they are     *)
(* parsed identically. The evaluator's slide-type schema enforces          *)
(* cardinality (e.g. `metric_tree` allows multiple `category` blocks but   *)
(* exactly one `root` block).                                              *)

(* -- List items -------------------------------------------------------- *)

list_item        ::= "-" value NEWLINE                      (* scalar item     *)
                   | "-" NEWLINE INDENT field+ DEDENT       (* object item     *)

(* -- Values ------------------------------------------------------------ *)

value            ::= string_literal
                   | number_literal
                   | bool_literal
                   | color_name
                   | inline_formatted
                   | bareword

string_literal   ::= simple_string | multiline_string

simple_string    ::= '"' string_char* '"'

multiline_string ::= '"""' multiline_char* '"""'

string_char      ::= /[^"\\\n]/ | escape

multiline_char   ::= /[^"]/                                 (* permissive; lexer *)
                                                            (* consumes content   *)
                                                            (* until closing """  *)

escape           ::= '\\' ( '"' | '\\' | 'n' | 'r' | 't' | 'u' '{' hex+ '}' )

number_literal   ::= '-'? digit+ ( '.' digit+ )?

bool_literal     ::= "true" | "false"

color_name       ::= "blue"      | "orange"     | "purple"
                   | "green"     | "red"        | "teal"
                   | "dark_gray" | "gray"       | "white"
                   | "light_blue" | "light_gray"

inline_formatted ::= ( "bold" | "italic" | "code" ) string_literal

bareword         ::= identifier                             (* identifier used    *)
                                                            (* as a value, e.g.   *)
                                                            (* "stack true" or    *)
                                                            (* "color blue"       *)

(* -- Lexical primitives ------------------------------------------------ *)

identifier       ::= /[a-zA-Z_][a-zA-Z0-9_]*/

digit            ::= /[0-9]/

hex              ::= /[0-9a-fA-F]/

(* -- Whitespace, comments, layout ------------------------------------- *)

comment          ::= '#' /[^\n]*/ NEWLINE

NEWLINE          ::= '\n'                                   (* CR translated by   *)
                                                            (* lexer if present   *)

INDENT           ::= (lexer-emitted: indentation level increased)

DEDENT           ::= (lexer-emitted: indentation level decreased)

WHITESPACE       ::= ' ' | '\t'                             (* tabs normalized    *)
                                                            (* to 4 spaces in     *)
                                                            (* the lexer before   *)
                                                            (* INDENT/DEDENT      *)
                                                            (* tracking           *)


(* ======================================================================== *)
(* Semantic notes (not grammar -- enforced by evaluator)                    *)
(* ======================================================================== *)
(*                                                                          *)
(* 1. Metadata fields                                                       *)
(*    Required: title, output                                               *)
(*    Optional: incident_id, date, author, template, classification         *)
(*                                                                          *)
(* 2. Slide field schemas per slide_type                                    *)
(*    Each slide_type has a defined schema enumerating allowed fields,      *)
(*    their cardinality, and value types. The evaluator validates           *)
(*    after parsing. Unknown fields are reported as warnings (forward       *)
(*    compatibility) unless --strict is passed.                             *)
(*                                                                          *)
(* 3. String escape sequences                                               *)
(*    Standard: \" \\ \n \r \t                                              *)
(*    Unicode:  \u{XXXX} where XXXX is 1-6 hex digits                       *)
(*    Other escapes are an error.                                           *)
(*                                                                          *)
(* 4. Comments                                                              *)
(*    Comments may appear on their own line at any indentation level.       *)
(*    Trailing comments on the same line as a field are also allowed:       *)
(*       title "Some Title"  # this is a trailing comment                   *)
(*    Comments do not affect INDENT/DEDENT calculation.                     *)
(*                                                                          *)
(* 5. Triple-quoted strings                                                 *)
(*    Multi-line strings preserve newlines and internal whitespace          *)
(*    verbatim. Common leading whitespace is NOT stripped automatically;    *)
(*    the evaluator may offer a dedent helper at the API level if needed.   *)
(*                                                                          *)
(* 6. Boolean values                                                        *)
(*    Only literal "true" and "false" are booleans. The barewords           *)
(*    "yes" and "no" are NOT booleans.                                      *)
(*                                                                          *)
(* 7. Color names                                                           *)
(*    The 11 color names are reserved as bareword values. Hex colors        *)
(*    are NOT supported in v1.0 -- color is constrained to the brand        *)
(*    palette to keep decks consistent. Future versions may add a           *)
(*    `palette` block in metadata for brand-specific overrides.             *)
(*                                                                          *)
(* 8. Reserved identifiers                                                  *)
(*    The slide_type names, plus metadata, slide, true, false, bold,        *)
(*    italic, code, and the 11 color names. These cannot be used as         *)
(*    field identifiers.                                                    *)
(*                                                                          *)
(* 9. Error recovery (chumsky-specific)                                     *)
(*    The parser must produce a partial AST when encountering syntax        *)
(*    errors, with error nodes inserted at the failure points. Errors       *)
(*    include source spans (line, column, length). The CLI renders          *)
(*    errors via miette/ariadne with colored output and source context.     *)
(*                                                                          *)
(* 10. Whitespace tolerance                                                 *)
(*    Trailing whitespace on a line is ignored.                             *)
(*    Empty lines between fields at the same level are allowed.             *)
(*    Empty lines do not affect INDENT/DEDENT.                              *)
(*                                                                          *)
(* ======================================================================== *)


(* ======================================================================== *)
(* Slide type schemas (illustrative; full schema in slide-types.md)        *)
(* ======================================================================== *)
(*                                                                          *)
(* This section enumerates the field schema for each slide type.            *)
(* Notation:                                                                *)
(*   field_name : type          required                                    *)
(*   field_name? : type         optional                                    *)
(*   field_name* : type         zero or more                                *)
(*   field_name+ : type         one or more                                 *)
(*                                                                          *)
(* SLIDE TYPE: title                                                        *)
(*   color? : color_name (default "blue")                                   *)
(*   title : string                                                         *)
(*   subtitle? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: content                                                      *)
(*   title : string                                                         *)
(*   bullets : list of (string | inline_formatted)                          *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: two_column                                                   *)
(*   title : string                                                         *)
(*   left : list of (string | inline_formatted)                             *)
(*   right : list of (string | inline_formatted)                            *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: highlight                                                    *)
(*   title : string                                                         *)
(*   highlight : string         (* the key callout statement *)             *)
(*   supporting : list of string                                            *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: content_stat                                                 *)
(*   title : string                                                         *)
(*   blocks : list of { header : string, description : string }             *)
(*       OR                                                                 *)
(*   bullets : list of string                                               *)
(*   stat : { value : string, label : string, color : color_name }          *)
(*       OR                                                                 *)
(*   stat_rows : list of { value : string, label : string }                 *)
(*   stat_color? : color_name                                               *)
(*   stat_accent? : color_name                                              *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: formula                                                      *)
(*   title : string                                                         *)
(*   result : string                                                        *)
(*   operator? : string (default "×")                                       *)
(*   stack? : bool (default true)                                           *)
(*   accent? : color_name                                                   *)
(*   term+ : { name : string, color : color_name, definition : string }     *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: weighted_composite                                           *)
(*   title : string                                                         *)
(*   composite_label? : string                                              *)
(*   components+ : { name : string, weight : number, color : color_name }   *)
(*   context? : string                                                      *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: metric_tree                                                  *)
(*   title : string                                                         *)
(*   root : { label : string, color : color_name }                          *)
(*   category+ : { header : string, color : color_name,                     *)
(*                 items : list of string }                                 *)
(*   footnote? : string                                                     *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: severity_cards                                               *)
(*   title : string                                                         *)
(*   gaps+ : { header : string, description : string,                       *)
(*             severity : string, color : color_name }                      *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: numbered_actions                                             *)
(*   title : string                                                         *)
(*   columns? : number (1, 2, or 3; default 2)                              *)
(*   actions+ : { text : string, category? : string, color : color_name }   *)
(*   legend? : list of { label : string, color : color_name }               *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: vertical_timeline | horizontal_timeline                      *)
(*   title : string                                                         *)
(*   events+ : { date : string, target : string, detail? : string,          *)
(*               impact : string, color : color_name,                       *)
(*               badge? : string, badge_color? : color_name }               *)
(*   footnote? : string                                                     *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: enhanced_table                                               *)
(*   title : string                                                         *)
(*   events+ : same as timeline                                             *)
(*   columns? : list of string                                              *)
(*   col_widths? : list of number   (* in inches *)                         *)
(*   footnote? : string                                                     *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: table                                                        *)
(*   title : string                                                         *)
(*   table+ : list of list of string                                        *)
(*   col_widths? : list of number                                           *)
(*   footnote? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: stat_callout (aliased as key_metrics)                        *)
(*   title : string                                                         *)
(*   style? : "cards" | "light" | "plain" (default "cards")                 *)
(*   accent? : color_name                                                   *)
(*   stats+ : { value : string, label : string, sublabel? : string,         *)
(*              color : color_name, accent? : color_name,                   *)
(*              status? : "pass" | "fail",                                  *)
(*              icon? : "check" | "arrow" }                                 *)
(*   context? : string                                                      *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: stats_summary                                                *)
(*   title : string                                                         *)
(*   top_stats+ : { value, label, sublabel?, color }                        *)
(*   top_accent? : color_name                                               *)
(*   summary : { header : string, color : color_name, bg_color? : color,   *)
(*               items+ : { value, label, sublabel? } }                     *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: highlight_boxes                                              *)
(*   title : string                                                         *)
(*   boxes{2} : { header : string, header_count? : string,                  *)
(*                items+ : string, item_icon? : "check" | "arrow",          *)
(*                bg_color : color_name, accent_color? : color_name,        *)
(*                text_color : color_name,                                  *)
(*                stat_value : string, stat_label : string,                 *)
(*                stat_color : color_name }                                 *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: split_contrast                                               *)
(*   title : string                                                         *)
(*   left_panel : { header, bg_color, text_color, accent_color?,            *)
(*                  dot_color, events+ : { date, text },                    *)
(*                  stat_value, stat_label, stat_color }                    *)
(*   right_panel : same as left_panel                                       *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: card_rows                                                    *)
(*   title : string                                                         *)
(*   left_header : string                                                   *)
(*   left_color : color_name                                                *)
(*   left+ : string                                                         *)
(*   right_header : string                                                  *)
(*   right_color : color_name                                               *)
(*   right+ : string                                                        *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: status                                                       *)
(*   title : string                                                         *)
(*   statuses+ : { label : string, value : string, color : color_name }     *)
(*   summary_stats? : list of { value, label, color }                       *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: progress_bar                                                 *)
(*   title : string                                                         *)
(*   progress_label? : string                                               *)
(*   resolved+ : { label : string, value : string }                         *)
(*   in_progress+ : { label : string, value : string }                      *)
(*   takeaway? : string                                                     *)
(*   talk_track? : string                                                   *)
(*                                                                          *)
(* SLIDE TYPE: end                                                          *)
(*   color? : "blue" | "purple" | "white" (default "blue")                  *)
(*                                                                          *)
(* SLIDE TYPE: divider (alias of title)                                     *)
(*   Identical schema to `title`.                                           *)
(*                                                                          *)
(* ======================================================================== *)
(* End of grammar.                                                          *)
(* ======================================================================== *)
